node_modules
dist
*.tsbuildinfo
.DS_Store
.env
.env.local
terrane.html
shots/
.cache

# The harvested cells live in object storage, not in git: ~382 MB of POI cells
# and ~288 MB of trail cells. `npm run poi:push` / `npm run data:upload` send them
# to the bucket; the map reads them from there.
public/poi/
public/.poi-staging
public/.poi-previous
public/trails/

# Generated at build time from the atlas and the runtime store.
public/sitemap.xml
public/robots.txt
public/coverage.json

# Python bytecode from the harvest scripts
__pycache__/
*.pyc

# Normalized source rows are reproduced by the adapters, not committed.
data/sources/*.ndjson
data/sources/*.ndjson.gz
data/upload-manifest.json

# Generated reports. `reports/coverage.json` is kept as the last known-good
# strict-gate baseline; everything else is written by a local run.
reports/*
!reports/coverage.json

# The dev server's own log, and the local Vercel link (`vercel link`).
.vercel
