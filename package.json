{
  "name": "terrane",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "node scripts/build-curated-index.mjs && node scripts/build-manifest.mjs && node scripts/validate-data.mjs && tsc -b && vite build && node scripts/gen-seo.mjs",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm test && npm run validate",
    "clean": "node scripts/clean.mjs",
    "atlas": "python3 scripts/build-atlas.py",
    "preview": "vite preview",
    "seo": "node scripts/gen-seo.mjs",
    "manifest": "node scripts/build-curated-index.mjs && node scripts/build-manifest.mjs",
    "validate": "node scripts/build-manifest.mjs && node scripts/validate-data.mjs",
    "audit": "node scripts/audit-data.mjs",
    "bands": "node scripts/band-report.mjs",
    "data:refresh": "node scripts/build-curated-index.mjs && npm run atlas && python3 scripts/harvest-reach.py && python3 scripts/harvest-poi-bulk.py && python3 scripts/harvest-poi-bulk.py --merge && python3 scripts/harvest-poi-bulk.py --report && npm run poi:stats && npm run validate && npm run audit",
    "poi:world": "python3 scripts/harvest-poi-bulk.py",
    "poi:merge": "python3 scripts/harvest-poi-bulk.py --merge",
    "poi:report": "python3 scripts/harvest-poi-bulk.py --report",
    "poi:stats": "node scripts/poi-stats.mjs",
    "poi:push": "bash scripts/poi-upload.sh",
    "poi:status": "python3 scripts/harvest-poi-bulk.py --status",
    "data:merge": "python3 scripts/merge-sources.py",
    "data:coverage": "node scripts/coverage-report.mjs",
    "data:upload": "node scripts/upload-changed.mjs",
    "data:state": "node scripts/fetch-source-state.mjs",
    "data:dedupe": "node scripts/dedupe-report.mjs"
  },
  "dependencies": {
    "maplibre-gl": "^5.24.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
